{
  "manifest_version": 3,
  "name": "OBS Cookie Helper",
  "version": "1.0",
  "description": "DPÜ OBS cookie'lerini otomatik olarak Python programına gönderir",
  
  "permissions": [
    "cookies",
    "tabs",
    "storage",
    "webRequest"
  ],
  
  "host_permissions": [
    "*://*.dpu.edu.tr/*",
    "http://localhost:5000/*",
    "http://127.0.0.1:5000/*"
  ],
  
  "background": {
    "service_worker": "background.js"
  },
  
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "128": "extension_icon.png"
    }
  },
  
  "icons": {
    "128": "extension_icon.png"
  }
}